# ============================================================
# StepUp Frontend — Variables de entorno de ejemplo
# Copia este archivo como .env.local y completa los valores.
# NEXT_PUBLIC_* son expuestas al navegador y al servidor SSR.
# ============================================================

# URL base del backend (incluye /api/v1)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# Nombre de la tienda (usado en SEO y UI)
NEXT_PUBLIC_APP_NAME=StepUp

# Número de WhatsApp (formato internacional sin + ni espacios, ej: 5491112345678)
NEXT_PUBLIC_WA_NUMBER=

# Mensaje base de WhatsApp (opcional, si vacío se usa el mensaje por defecto)
NEXT_PUBLIC_DEFAULT_WA_MESSAGE=

# Entorno
NODE_ENV=development
