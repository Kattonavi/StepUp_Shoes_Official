# ============================================================
# StepUp Frontend — Variables de entorno de ejemplo
# Copia este archivo como .env.local para desarrollo local.
# Para Railway, configurar como variables del servicio en la UI.
#
# IMPORTANTE: Las variables NEXT_PUBLIC_* se injectan en BUILD TIME.
# Si las cambias, debes hacer redeploy del frontend.
# ============================================================

# ────────────────────────────────────────────────────────────
# API BASE URL (REQUERIDA)
# ────────────────────────────────────────────────────────────
# Desarrollo local
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
# Producción Railway — reemplazar con la URL real del servicio backend:
# NEXT_PUBLIC_API_BASE_URL=https://stepup-backend.up.railway.app/api/v1

# ────────────────────────────────────────────────────────────
# APP
# ────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=StepUp

# URL pública del frontend (usada para construir links compartibles)
# NEXT_PUBLIC_APP_URL=https://stepup-frontend.up.railway.app

# ────────────────────────────────────────────────────────────
# WHATSAPP (fallback si Settings backend no está disponible)
# ────────────────────────────────────────────────────────────
# Número sin + ni espacios (ej: 573001234567)
NEXT_PUBLIC_WA_NUMBER=
NEXT_PUBLIC_DEFAULT_WA_MESSAGE=

# ────────────────────────────────────────────────────────────
# NODE
# ────────────────────────────────────────────────────────────
NODE_ENV=development
