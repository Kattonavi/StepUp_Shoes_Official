# ============================================================
# StepUp — Variables de entorno de referencia (monorepo root)
# Copiar este archivo a .env y configurar los valores reales.
# NUNCA subir .env al repositorio.
# ============================================================
#
# --- Base de datos ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=stepup_dev
DB_USER=stepup
DB_PASSWORD=changeme

# --- Backend ---
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=dev
JWT_SECRET=change-this-to-a-secure-random-string-minimum-64-chars
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
FRONTEND_PORT=3000

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:3000

# --- SUPER_ADMIN seed (solo para inicialización) ---
SUPER_ADMIN_EMAIL=superadmin@stepup.local
SUPER_ADMIN_PASSWORD=change-this-immediately

# --- Tienda ---
STORE_NAME=StepUp
STORE_WHATSAPP=+1234567890

# --- Railway (producción) ---
# DATABASE_URL=postgresql://user:password@host:port/dbname
# RAILWAY_STATIC_URL=
