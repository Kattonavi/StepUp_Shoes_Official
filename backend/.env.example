# ============================================================
# StepUp Backend — Variables de entorno de ejemplo
# Copiar a .env y configurar. NUNCA subir .env al repo.
# ============================================================

# Perfil de Spring activo: dev | prod | test
SPRING_PROFILES_ACTIVE=dev

# --- Base de datos ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=stepup_dev
DB_USER=stepup
DB_PASSWORD=changeme

# En Railway, usar directamente:
# DATABASE_URL=postgresql://user:password@host:port/dbname

# --- JWT ---
# Mínimo 32 caracteres, recomendado 64+ para producción.
# Generar con: openssl rand -hex 64
JWT_SECRET=change-this-to-a-secure-random-string-at-least-64-characters-long-for-hs256

# Duración del access token (minutos). Default: 15
JWT_ACCESS_EXPIRATION_MINUTES=15

# Duración del refresh token (días). Default: 7
JWT_REFRESH_EXPIRATION_DAYS=7

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:3000

# --- SUPER_ADMIN seed ---
# Se crean solo si no existe ningún SUPER_ADMIN.
# En producción cambiar inmediatamente después del primer login.
SUPER_ADMIN_EMAIL=superadmin@stepup.local
SUPER_ADMIN_PASSWORD=changeme-use-a-very-strong-password-in-production
SUPER_ADMIN_FULL_NAME=Super Admin

# --- App ---
SERVER_PORT=8080
