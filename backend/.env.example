# ============================================================
# StepUp Backend — Variables de entorno de ejemplo
# Copiar a .env para desarrollo local. NUNCA subir .env al repo.
# Para Railway, configurar como variables del servicio en la UI.
# ============================================================

# ────────────────────────────────────────────────────────────
# PERFIL
# ────────────────────────────────────────────────────────────
# Desarrollo local
SPRING_PROFILES_ACTIVE=dev
# Producción Railway → prod
# SPRING_PROFILES_ACTIVE=prod

# ────────────────────────────────────────────────────────────
# SERVIDOR
# ────────────────────────────────────────────────────────────
# Railway sobreescribe PORT automáticamente. No configurar en Railway UI.
PORT=8080

# ────────────────────────────────────────────────────────────
# BASE DE DATOS — Desarrollo local
# ────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=stepup_dev
DB_USER=stepup
DB_PASSWORD=changeme

# ────────────────────────────────────────────────────────────
# BASE DE DATOS — Producción Railway
# El plugin PostgreSQL de Railway provee automáticamente:
#   PGHOST, PGPORT, PGDATABASE, PGUSER, PGPASSWORD
#
# IMPORTANTE: Railway también expone DATABASE_URL, pero en formato postgresql://
# (sin prefijo jdbc:). Spring Boot necesita jdbc:postgresql://, por eso
# application-prod.yml construye la URL desde PGHOST/PGPORT/PGDATABASE.
#
# En Railway, agregar estas variables al servicio backend apuntando al plugin Postgres:
#   PGHOST=${{Postgres.PGHOST}}
#   PGPORT=${{Postgres.PGPORT}}
#   PGDATABASE=${{Postgres.PGDATABASE}}
#   PGUSER=${{Postgres.PGUSER}}
#   PGPASSWORD=${{Postgres.PGPASSWORD}}
#
# Override manual con URL JDBC completa (opcional):
#   DATABASE_URL_JDBC=jdbc:postgresql://host:port/database
#   DATABASE_USERNAME=user
#   DATABASE_PASSWORD=password
# ────────────────────────────────────────────────────────────
# PGHOST=
# PGPORT=5432
# PGDATABASE=
# PGUSER=
# PGPASSWORD=

# ────────────────────────────────────────────────────────────
# JWT
# ────────────────────────────────────────────────────────────
# Generar secreto seguro: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# O: openssl rand -hex 64
# Mínimo 64 caracteres para HS256 en producción.
JWT_SECRET=change-this-to-a-secure-random-string-at-least-64-characters-long-for-hs256
JWT_ACCESS_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=7

# ────────────────────────────────────────────────────────────
# CORS
# ────────────────────────────────────────────────────────────
# Desarrollo local
ALLOWED_ORIGINS=http://localhost:3000
# Producción: URL del frontend Railway (agregar ambas si necesario)
# ALLOWED_ORIGINS=https://stepup-frontend.up.railway.app

# ────────────────────────────────────────────────────────────
# SUPER_ADMIN SEED
# Se crea solo si no existe ningún SUPER_ADMIN en la base de datos.
# En producción, cambiar password inmediatamente después del primer login.
# Si las variables están vacías, el backend arranca sin crear SUPER_ADMIN.
# ────────────────────────────────────────────────────────────
SUPER_ADMIN_EMAIL=superadmin@stepup.local
SUPER_ADMIN_PASSWORD=changeme-use-a-very-strong-password-in-production
SUPER_ADMIN_FULL_NAME=Super Admin
# Reset controlado de contraseña (ver docs/deployment.md §16). Mantener false en operación normal.
SUPER_ADMIN_RESET_PASSWORD=false

# ────────────────────────────────────────────────────────────
# FLYWAY
# ────────────────────────────────────────────────────────────
# false (default): base de datos nueva sin tablas — Railway primer deploy.
# true: SOLO si la base ya tiene tablas creadas sin Flyway y se hace baseline manual.
#   Usar true a ciegas puede hacer que Flyway salte migraciones existentes.
FLYWAY_BASELINE_ON_MIGRATE=false

# ────────────────────────────────────────────────────────────
# HIBERNATE DDL
# ────────────────────────────────────────────────────────────
# validate (default): Hibernate verifica que el esquema coincida con las entidades.
#   Falla al arrancar si falta alguna tabla — Flyway debe haberlas creado primero.
# none: Hibernate no valida ni modifica el esquema (útil para diagnóstico temporal
#   cuando se sospecha que Flyway no corrió y se quiere ver los logs sin que
#   Hibernate falle primero). NUNCA dejar como valor permanente en producción.
HIBERNATE_DDL_AUTO=validate
